rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só pode ler e escrever dentro da própria árvore de dados,
    // identificada pelo próprio uid. Ninguém acessa dados de outra pessoa.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
