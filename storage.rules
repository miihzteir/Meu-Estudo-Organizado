rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // PDFs ficam em pastas separadas por usuário (uid) e matéria.
    // Só o dono (uid autenticado) pode ler ou escrever seus próprios arquivos.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
